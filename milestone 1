"""
MediTrack - Milestone 1 Complete Demo
"""

patients=[]
appointments=[]

class Patient:
    def __init__(self,pid,name,age,gender,phone,blood):
        self.pid=pid
        self.name=name
        self.age=age
        self.gender=gender
        self.phone=phone
        self.blood=blood

class Appointment:
    def __init__(self,pid,doctor,date,time):
        self.pid=pid
        self.doctor=doctor
        self.date=date
        self.time=time

def find_patient(pid):
    for p in patients:
        if p.pid==pid:
            return p
    return None

def register():
    pid=input("Patient ID : ")
    if find_patient(pid):
        print("Patient ID already exists")
        return
    name=input("Name : ")
    age=input("Age : ")
    gender=input("Gender : ")
    phone=input("Phone : ")
    blood=input("Blood Group : ")
    patients.append(Patient(pid,name,age,gender,phone,blood))
    print("Patient Registered")

def view_patients():
    if not patients:
        print("No Patients")
        return
    for p in patients:
        print("-"*40)
        print("ID:",p.pid)
        print("Name:",p.name)
        print("Age:",p.age)
        print("Gender:",p.gender)
        print("Phone:",p.phone)
        print("Blood:",p.blood)

def search():
    p=find_patient(input("Patient ID : "))
    if not p:
        print("Patient Not Found")
        return
    print(vars(p))

def update():
    p=find_patient(input("Patient ID : "))
    if not p:
        print("Patient Not Found")
        return
    p.name=input("New Name : ")
    p.age=input("New Age : ")
    p.gender=input("New Gender : ")
    p.phone=input("New Phone : ")
    p.blood=input("New Blood Group : ")
    print("Updated")

def delete():
    p=find_patient(input("Patient ID : "))
    if not p:
        print("Patient Not Found")
        return
    patients.remove(p)
    global appointments
    appointments=[a for a in appointments if a.pid!=p.pid]
    print("Deleted")

def book():
    pid=input("Patient ID : ")
    if not find_patient(pid):
        print("Patient Not Found")
        return
    doctor=input("Doctor : ")
    date=input("Date : ")
    time=input("Time : ")
    for a in appointments:
        if a.doctor==doctor and a.date==date and a.time==time:
            print("Slot Already Booked")
            return
    appointments.append(Appointment(pid,doctor,date,time))
    print("Appointment Booked")

def view_appointments():
    if not appointments:
        print("No Appointments")
        return
    for a in appointments:
        p=find_patient(a.pid)
        print("-"*40)
        print("Patient:",p.name if p else a.pid)
        print("Doctor:",a.doctor)
        print("Date:",a.date)
        print("Time:",a.time)

def cancel():
    pid=input("Patient ID : ")
    for a in appointments:
        if a.pid==pid:
            appointments.remove(a)
            print("Cancelled")
            return
    print("Appointment Not Found")

def dashboard():
    print("Total Patients:",len(patients))
    print("Total Appointments:",len(appointments))

while True:
    print("\n===== MEDITRACK =====")
    print("1.Register Patient")
    print("2.View Patients")
    print("3.Search Patient")
    print("4.Update Patient")
    print("5.Delete Patient")
    print("6.Book Appointment")
    print("7.View Appointments")
    print("8.Cancel Appointment")
    print("9.Dashboard")
    print("10.Exit")
    ch=input("Choice : ")
    if ch=="1": register()
    elif ch=="2": view_patients()
    elif ch=="3": search()
    elif ch=="4": update()
    elif ch=="5": delete()
    elif ch=="6": book()
    elif ch=="7": view_appointments()
    elif ch=="8": cancel()
    elif ch=="9": dashboard()
    elif ch=="10":
        print("Thank You")
        break
    else:
        print("Invalid Choice")
